<view class="scan-page">
  <view class="scan-nav"><view class="scan-home" bindtap="goHome"><text class="icon icon-home"></text></view><view>{{state==='success'?'登录成功':'确认后台登录'}}</view></view>
  <view wx:if="{{state==='loading'}}" class="state-panel"><view class="spinner"></view><view class="state-title">正在验证管理员身份</view><view class="state-copy">正在读取本次电脑端登录请求</view></view>
  <block wx:if="{{state==='confirm'}}">
    <view class="request-card"><view class="request-head"><view class="device-icon"><view class="laptop"></view></view><view><view class="request-title">电脑端请求登录企业后台</view><view class="request-subtitle">确认后电脑将以管理员身份进入</view></view></view><view class="request-divider"></view><view class="meta-row"><text>设备</text><view>{{device}}</view></view><view class="meta-row"><text>地点</text><view>{{location}}{{ip?' · IP '+ip:''}}</view></view><view class="meta-row"><text>时间</text><view>今天 {{requestTime}}</view></view><view class="expiry-note">二维码 <text>{{remaining}}</text> 后失效，请勿向他人转发。</view></view>
    <view class="tenant-heading"><text>选择要管理的企业</text><view>{{tenants.length}} 个管理员身份</view></view>
    <view wx:for="{{tenants}}" wx:key="tenant_id" class="tenant-card {{selectedTenant.tenant_id===item.tenant_id?'tenant-card--selected':''}}" data-id="{{item.tenant_id}}" bindtap="selectTenant"><view class="tenant-logo">{{item.initial}}</view><view class="tenant-copy"><view class="tenant-name">{{item.tenant_name}} <text>{{item.roleLabel}}</text></view><view class="tenant-meta">{{item.member_count}} 名成员 · {{item.lastLoginText}}</view></view><view class="radio"><view wx:if="{{selectedTenant.tenant_id===item.tenant_id}}">✓</view></view></view>
    <view wx:if="{{error}}" class="inline-error">{{error}}</view><view class="action-footer"><button class="primary-action" loading="{{submitting}}" disabled="{{submitting||!selectedTenant}}" bindtap="confirmSelected">确认登录{{selectedTenant?' '+selectedTenant.tenant_name:''}}</button><button class="text-action" bindtap="rejectLogin">不是我操作，拒绝本次登录</button></view>
  </block>
  <block wx:if="{{state==='success'}}"><view class="success-panel"><view class="success-mark">✓</view><view class="success-title">电脑端已登录</view><view class="success-copy">请返回电脑继续操作，本次登录状态 8 小时内有效。</view><view class="success-tenant"><view class="tenant-logo">{{selectedTenant.initial}}</view><view><view>{{selectedTenant.tenant_name}}</view><text>身份：{{selectedTenant.roleLabel}} · {{requestTime}} 授权</text></view></view></view><view wx:if="{{error}}" class="inline-error success-error">{{error}}</view><view class="security-tip">如非本人操作，请立即退出登录并联系企业管理员。</view><view class="action-footer action-footer--success"><button class="primary-action" bindtap="goHome"><text class="icon icon-home"></text>返回首页</button><button class="secondary-action" bindtap="exitDesktop">退出电脑端登录</button></view></block>
  <view wx:if="{{state==='error'}}" class="state-panel"><view class="error-mark">!</view><view class="state-title">无法确认登录</view><view class="state-copy">{{error}}</view><button class="secondary-action retry-action" bindtap="prepare">重新验证</button></view>
</view>
