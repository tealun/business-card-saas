.scan-page{min-height:100vh;padding:0 32rpx 240rpx;background:#f4f6f8;color:#101828;box-sizing:border-box}.scan-nav{height:96rpx;display:flex;align-items:center;justify-content:center;font-size:34rpx;font-weight:500;background:#fff;margin:0 -32rpx 32rpx;position:relative}.scan-home{position:absolute;left:32rpx;width:64rpx;height:64rpx;display:flex;align-items:center;justify-content:center}.scan-home .icon{width:36rpx;height:36rpx;background:#101828}.request-card,.state-panel,.success-panel{background:#fff;border-radius:28rpx;padding:34rpx;box-sizing:border-box}.request-head{display:flex;align-items:center;gap:24rpx}.device-icon{width:88rpx;height:88rpx;border-radius:22rpx;background:#eef2ff;display:flex;align-items:center;justify-content:center}.laptop{width:42rpx;height:28rpx;border:3rpx solid #4d70d8;border-radius:3rpx;position:relative}.laptop:after{content:"";position:absolute;left:-8rpx;right:-8rpx;bottom:-10rpx;height:3rpx;background:#4d70d8}.request-title{font-size:31rpx;font-weight:700}.request-subtitle{margin-top:8rpx;color:#98a2b3;font-size:24rpx}.request-divider{height:2rpx;background:#eaecf0;margin:28rpx 0 20rpx}.meta-row{display:flex;min-height:54rpx;align-items:center;font-size:26rpx}.meta-row text{width:132rpx;color:#98a2b3}.meta-row view{flex:1}.expiry-note{margin-top:20rpx;padding:22rpx 24rpx;border-radius:18rpx;background:#fff6e6;color:#a15c00;font-size:24rpx}.expiry-note text{font-weight:700}.tenant-heading{display:flex;justify-content:space-between;margin:38rpx 4rpx 20rpx;font-size:26rpx;font-weight:700}.tenant-heading view{color:#98a2b3;font-weight:400}.tenant-card{height:148rpx;padding:22rpx 28rpx;margin-bottom:20rpx;border:2rpx solid #e4e7ec;border-radius:28rpx;background:#fff;display:flex;align-items:center;gap:24rpx;box-sizing:border-box}.tenant-card--selected{border-color:#4d70d8}.tenant-logo{width:90rpx;height:90rpx;border-radius:22rpx;background:#4d70d8;color:#fff;display:flex;align-items:center;justify-content:center;font-size:34rpx;font-weight:700;flex:none}.tenant-card:not(.tenant-card--selected) .tenant-logo{background:#eef0f4;color:#667085}.tenant-copy{flex:1;min-width:0}.tenant-name{font-size:30rpx;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.tenant-name text{margin-left:10rpx;padding:4rpx 8rpx;border-radius:6rpx;background:#eef2ff;color:#4d70d8;font-size:20rpx;font-weight:500}.tenant-meta{margin-top:12rpx;color:#98a2b3;font-size:23rpx}.radio{width:42rpx;height:42rpx;border:2rpx solid #d0d5dd;border-radius:50%;display:flex;align-items:center;justify-content:center}.radio view{width:42rpx;height:42rpx;border-radius:50%;background:#4d70d8;color:#fff;text-align:center;line-height:42rpx;font-size:24rpx}.action-footer{position:fixed;z-index:5;left:32rpx;right:32rpx;bottom:calc(24rpx + env(safe-area-inset-bottom));background:#f4f6f8}.primary-action,.secondary-action{width:100%;height:96rpx;border-radius:18rpx;font-size:30rpx}.primary-action{background:#4d70d8;color:#fff;box-shadow:0 12rpx 24rpx rgba(77,112,216,.24)}.primary-action .icon{width:30rpx;height:30rpx;margin-right:12rpx;background:#fff;vertical-align:middle}.text-action{width:100%;height:72rpx;color:#98a2b3;font-size:25rpx}.secondary-action{margin-top:18rpx;background:#fff;border:2rpx solid #d0d5dd;color:#344054}.inline-error{margin:16rpx 4rpx;color:#d92d20;font-size:24rpx}.success-panel{margin-top:30rpx;padding:70rpx 48rpx 54rpx;text-align:center}.success-mark{width:116rpx;height:116rpx;margin:0 auto 34rpx;border-radius:50%;background:#eef2ff;color:#4d70d8;font-size:56rpx;line-height:116rpx}.success-title{font-size:38rpx;font-weight:700}.success-copy{margin-top:20rpx;color:#667085;font-size:25rpx;line-height:1.7}.success-tenant{margin-top:48rpx;padding:24rpx;border-radius:20rpx;background:#f7f8fa;display:flex;align-items:center;gap:22rpx;text-align:left;font-size:28rpx}.success-tenant .tenant-logo{width:78rpx;height:78rpx;border-radius:18rpx;font-size:30rpx}.success-tenant text{display:block;margin-top:8rpx;color:#98a2b3;font-size:23rpx}.security-tip{text-align:center;color:#98a2b3;font-size:24rpx;margin-top:38rpx}.action-footer--success .primary-action{display:flex;align-items:center;justify-content:center}.success-error{text-align:center}.state-panel{margin-top:80rpx;text-align:center;padding:80rpx 42rpx}.state-title{margin-top:28rpx;font-size:34rpx;font-weight:700}.state-copy{margin-top:16rpx;color:#667085;font-size:25rpx;line-height:1.7}.spinner{width:70rpx;height:70rpx;margin:auto;border:7rpx solid #e4e7ec;border-top-color:#4d70d8;border-radius:50%;animation:spin .8s linear infinite}.error-mark{width:88rpx;height:88rpx;margin:auto;border-radius:50%;background:#fef3f2;color:#d92d20;font-size:46rpx;line-height:88rpx}.retry-action{margin-top:40rpx}@keyframes spin{to{transform:rotate(360deg)}}
