.join-page{position:relative;min-height:100vh;padding:calc(env(safe-area-inset-top) + 34rpx) 40rpx calc(150rpx + env(safe-area-inset-bottom));box-sizing:border-box;background:#f4f6f8;color:#172033}.join-page::before{content:"";position:absolute;top:0;left:0;right:0;height:560rpx;background:radial-gradient(circle,rgba(255,255,255,.22) 2rpx,transparent 3rpx),linear-gradient(150deg,#3455ad,#5276d8);background-size:38rpx 38rpx,auto}.join-nav{position:relative;z-index:1;height:86rpx;display:flex;align-items:center;justify-content:center;color:#fff;font-size:34rpx}.join-home{position:absolute;left:0;width:64rpx;height:64rpx;display:flex;align-items:center;justify-content:center}.join-home .icon-home{background-color:#fff}.company-identity{position:relative;z-index:1;text-align:center;color:#fff;padding:20rpx 0 48rpx}.company-logo{width:124rpx;height:124rpx;margin:0 auto 24rpx;border:2rpx solid rgba(255,255,255,.5);border-radius:34rpx;background:rgba(255,255,255,.15);display:flex;align-items:center;justify-content:center;font-size:50rpx;font-weight:700;overflow:hidden}.company-logo image{width:100%;height:100%}.company-name{font-size:38rpx;font-weight:700}.company-invite{margin-top:8rpx;font-size:25rpx}.join-form,.success-card,.company-link{position:relative;z-index:1;background:#fff;border-radius:28rpx;box-shadow:0 16rpx 48rpx rgba(23,32,51,.08)}.join-form{padding:0 30rpx}.join-row{height:108rpx;display:flex;align-items:center}.join-label{width:130rpx;color:#62708a;font-size:28rpx}.join-row input{flex:1;font-size:30rpx}.join-notice{position:relative;z-index:1;margin-top:30rpx;padding:28rpx;border-radius:20rpx;background:#edf2ff;color:#536684;font-size:25rpx;line-height:1.7;display:flex;gap:16rpx}.join-notice__icon{flex:0 0 28rpx;width:28rpx;height:28rpx;margin-top:7rpx;border:2rpx solid #4d71d3;border-radius:50%;color:#4d71d3;font-size:20rpx;line-height:28rpx;text-align:center}.join-error{position:relative;z-index:1;margin-top:20rpx;padding:20rpx;border-radius:16rpx;background:#fef2f2;color:#b91c1c;font-size:25rpx}.join-footer{position:absolute;z-index:2;left:40rpx;right:40rpx;bottom:calc(28rpx + env(safe-area-inset-bottom));text-align:center;color:#a0a7b5;font-size:23rpx}.join-button,.withdraw-button{height:92rpx;margin-bottom:18rpx;border-radius:16rpx;font-size:30rpx}.join-button{color:#fff;background:#4d71d3;box-shadow:0 12rpx 28rpx rgba(77,113,211,.28)}.join-button::after,.withdraw-button::after{border:0}.success-card{margin-top:44rpx;padding:58rpx 38rpx;text-align:center}.success-clock{position:relative;width:112rpx;height:112rpx;margin:0 auto 26rpx;border-radius:50%;background:#eef2fc}.success-clock::before{content:"";position:absolute;left:34rpx;top:34rpx;width:40rpx;height:40rpx;border:4rpx solid #4d71d3;border-radius:50%}.success-clock::after{content:"";position:absolute;left:54rpx;top:43rpx;width:4rpx;height:18rpx;background:#4d71d3;border-radius:2rpx}.success-clock view{position:absolute;left:54rpx;top:59rpx;width:15rpx;height:4rpx;background:#4d71d3;transform:rotate(25deg);transform-origin:left center}.success-title{font-size:38rpx;font-weight:700}.success-desc{margin-top:16rpx;color:#67738a;font-size:25rpx;line-height:1.8}.company-link{margin-top:34rpx;padding:24rpx;display:flex;align-items:center;gap:22rpx}.company-link--disabled{opacity:.55}.company-link-logo{width:78rpx;height:78rpx;border-radius:18rpx;background:#4d71d3;color:#fff;display:flex;align-items:center;justify-content:center;font-size:32rpx;font-weight:700}.company-link-copy{flex:1;font-size:28rpx;font-weight:600}.company-link-copy text{display:block;margin-top:4rpx;color:#8a94a7;font-size:23rpx;font-weight:400}.withdraw-button{color:#33405a;background:#fff;border:2rpx solid #d8dde7}
