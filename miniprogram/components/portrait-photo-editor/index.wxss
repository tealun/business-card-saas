.portrait-photo-editor__head {
  gap: 18rpx;
}

.portrait-photo-editor__sub {
  max-width: 420rpx;
  margin-top: 8rpx;
  line-height: 1.5;
}

.portrait-photo-editor__preview {
  position: relative;
  height: 300rpx;
  margin-top: 24rpx;
  border: 2rpx dashed var(--divider);
  border-radius: 18rpx;
  background:
    linear-gradient(45deg, rgba(154,161,172,.12) 25%, transparent 25%),
    linear-gradient(-45deg, rgba(154,161,172,.12) 25%, transparent 25%),
    linear-gradient(45deg, transparent 75%, rgba(154,161,172,.12) 75%),
    linear-gradient(-45deg, transparent 75%, rgba(154,161,172,.12) 75%),
    #fff;
  background-position: 0 0, 0 18rpx, 18rpx -18rpx, -18rpx 0;
  background-size: 36rpx 36rpx;
  overflow: hidden;
}

.portrait-photo-editor__preview--filled {
  border-style: solid;
}

.portrait-photo-editor__image {
  width: 100%;
  height: 100%;
}

.portrait-photo-editor__empty {
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  color: var(--text-tertiary);
  font-size: 24rpx;
}

.portrait-photo-editor__actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 18rpx;
}

.portrait-photo-editor__error {
  margin-top: 10rpx;
  color: var(--danger);
  font-size: 22rpx;
}
