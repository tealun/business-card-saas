<view class="card portrait-photo-editor">
  <view class="row-between portrait-photo-editor__head">
    <view>
      <view class="card__title">形象照</view>
      <view class="f12 t-secondary portrait-photo-editor__sub">JPG / PNG / WebP · 短边 500 像素以上 · 上传后裁切</view>
    </view>
    <view class="btn btn--sm btn--soft {{editable ? '' : 'btn--disabled'}}" bindtap="onChoosePhoto">
      {{url ? "更换" : "上传"}}
    </view>
  </view>
  <view class="portrait-photo-editor__preview {{url || defaultPhotoUrl ? 'portrait-photo-editor__preview--filled' : ''}}" bindtap="onChoosePhoto">
    <image wx:if="{{url || defaultPhotoUrl}}" class="portrait-photo-editor__image" src="{{url || defaultPhotoUrl}}" mode="aspectFit" webp="{{true}}" />
    <view wx:else class="portrait-photo-editor__empty">
      <view class="icon icon-camera"></view>
      <text>{{editable ? "上传并裁切形象照" : lockedText}}</text>
    </view>
  </view>
  <view class="portrait-photo-editor__actions" wx:if="{{url && editable}}">
    <view class="btn btn--sm btn--muted" bindtap="onClearPhoto">清除形象照</view>
  </view>
  <view class="portrait-photo-editor__error" wx:if="{{error}}">{{error}}</view>
</view>

<square-image-cropper
  visible="{{cropVisible}}"
  src="{{cropSource}}"
  title="裁切形象照"
  file-type="{{cropFileType}}"
  bindcancel="onCropCancel"
  bindconfirm="onCropConfirm"
  binderror="onCropError"
/>
