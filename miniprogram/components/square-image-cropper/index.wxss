.cropper {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 9999;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, .72);
}

.cropper__panel {
  width: 100%;
  padding: 30rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 24rpx 24rpx 0 0;
  background: #111318;
  box-sizing: border-box;
}

.cropper__head {
  margin-bottom: 24rpx;
  text-align: center;
}

.cropper__title {
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
}

.cropper__hint {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, .64);
  font-size: 24rpx;
}

.cropper__viewport {
  position: relative;
  width: 694rpx;
  height: 694rpx;
  margin: 0 auto;
  overflow: hidden;
  background-color: #fff;
  background-image:
    linear-gradient(45deg, #d9dde3 25%, transparent 25%),
    linear-gradient(-45deg, #d9dde3 25%, transparent 25%),
    linear-gradient(45deg, transparent 75%, #d9dde3 75%),
    linear-gradient(-45deg, transparent 75%, #d9dde3 75%);
  background-position: 0 0, 0 24rpx, 24rpx -24rpx, -24rpx 0;
  background-size: 48rpx 48rpx;
}

.cropper__movable,
.cropper__image {
  display: block;
}

.cropper__image {
  width: 100%;
  height: 100%;
}

.cropper__shade {
  pointer-events: none;
  position: absolute;
  left: 0;
  right: 0;
  height: 2rpx;
  background: rgba(0, 0, 0, .22);
}

.cropper__shade--top { top: 0; }
.cropper__shade--bottom { bottom: 0; }

.cropper__frame {
  pointer-events: none;
  position: absolute;
  inset: 0;
  border: 2rpx solid rgba(255, 255, 255, .9);
  box-shadow: inset 0 0 0 1rpx rgba(0, 0, 0, .35);
  box-sizing: border-box;
}

.cropper__actions {
  display: grid;
  grid-template-columns: 1fr 1.5fr;
  gap: 20rpx;
  margin-top: 28rpx;
}

.cropper__button {
  height: 88rpx;
  border-radius: 8rpx;
  font-size: 30rpx;
  line-height: 88rpx;
}

.cropper__button::after { border: 0; }
.cropper__button--cancel { color: #fff; background: #30333a; }
.cropper__button--confirm { color: #fff; background: var(--brand, #3178ff); }

.cropper__canvas {
  position: fixed;
  left: -10000px;
  top: -10000px;
  width: 900px;
  height: 900px;
}
